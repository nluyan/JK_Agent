# Agent 配置示例

# 服务器地址
# AGENT_SERVER_URL=http://localhost:5000/agenthub
AGENT_SERVER_URL=http://your-signalr-server:5000/agenthub

# 代理分组
# AGENT_GROUP=default
AGENT_GROUP=production

# 注意：
# 1. Windows 系统使用 PowerShell 设置环境变量：
#    $env:AGENT_SERVER_URL = "http://your-server:5000/agenthub"
#    $env:AGENT_GROUP = "production"
#
# 2. Linux/macOS 系统使用 bash 设置环境变量：
#    export AGENT_SERVER_URL="http://your-server:5000/agenthub"
#    export AGENT_GROUP="production"
#
# 3. 或者在 systemd 服务文件中设置：
#    [Service]
#    Environment="AGENT_SERVER_URL=http://your-server:5000/agenthub"
#    Environment="AGENT_GROUP=production"
