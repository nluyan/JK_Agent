Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\jike]
@="Jike Remote Desktop Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\jike\DefaultIcon]
@="C:\\start.exe,0"

[HKEY_CLASSES_ROOT\jike\shell]

[HKEY_CLASSES_ROOT\jike\shell\open]

[HKEY_CLASSES_ROOT\jike\shell\open\command]
@="\"C:\\start.exe\" \"%1\""